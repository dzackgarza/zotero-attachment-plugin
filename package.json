{
  "name": "local-write-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/bootstrap.ts --outfile=src/bootstrap.js --target=firefox115",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/bootstrap.ts",
    "test": "bun test --coverage --coverage-reporter=lcov --coverage-dir=.",
    "openapi:lint": "redocly lint openapi.yaml",
    "openapi:contract": "bun test tests/openapi-contract.test.ts",
    "openapi:check": "bun run openapi:lint && bun run openapi:contract"
  },
  "devDependencies": {
    "@redocly/cli": "^2.39.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@zotero-plugin/eslint-config": "^0.6.8",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "js-yaml": "^5.2.1",
    "typescript": "^5.9.3",
    "zotero-types": "^4.1.2"
  }
}
